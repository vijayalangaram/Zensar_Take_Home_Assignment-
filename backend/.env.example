# Copy this file to .env and fill in your key.
# Leave ANTHROPIC_API_KEY blank to run the agent in mock mode (canned demo data,
# no network calls, no cost) — useful for exercising the UI without a key.
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=data/reports.db
